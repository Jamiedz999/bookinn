# Template for the production .env. On the EC2 host, copy this to `.env` in the same directory and
# fill in real values. The real .env is git-ignored and lives ONLY on the host — never commit it.
#
#   cp .env.example .env && nano .env

# ECR registry host (from `aws ecr describe-repositories`), e.g. 123456789012.dkr.ecr.eu-west-2.amazonaws.com
ECR_REGISTRY=<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com

# Image tag to deploy. `latest` for manual deploys; CI (M8) will pin to a commit SHA.
IMAGE_TAG=latest

# RDS MySQL connection (private VPC endpoint from `aws rds describe-db-instances`).
BOOKINN_DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/bookinn
BOOKINN_DB_USERNAME=bookinn
BOOKINN_DB_PASSWORD=<STRONG_DB_PASSWORD>

# HS256 signing key — must be >= 32 bytes. Generate with: openssl rand -hex 32
BOOKINN_JWT_SECRET=<64_HEX_CHARS>
