# Template for the production .env. On the EC2 host, copy this to `.env` in the same directory and
# fill in real values. The real .env is git-ignored and lives ONLY on the host — never commit it.
#
#   cp .env.example .env && nano .env

# ECR registry host (the part before the "/" in a repo URI), e.g.
# 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com

# Image tag to deploy. `latest` for manual deploys; CI (M8) will pin to a commit SHA.
IMAGE_TAG=latest

# Database — self-hosted MySQL container on the compose network (ADR 0006), NOT RDS. The host is the
# compose service name `mysql`, not an endpoint. The URL MUST end with the database name /bookinn,
# or Flyway fails with "Unable to determine schema".
BOOKINN_DB_URL=jdbc:mysql://mysql:3306/bookinn
# Single source of truth for the app DB credentials: the mysql container creates this user/password
# (as MYSQL_USER/MYSQL_PASSWORD) and the backend connects with the same values.
BOOKINN_DB_USERNAME=bookinn
BOOKINN_DB_PASSWORD=<STRONG_DB_PASSWORD>

# MySQL root password — used only inside the container (init + healthcheck); never published.
MYSQL_ROOT_PASSWORD=<STRONG_ROOT_PASSWORD>

# HS256 signing key — must be >= 32 bytes. Generate with: openssl rand -hex 32
BOOKINN_JWT_SECRET=<64_HEX_CHARS>
