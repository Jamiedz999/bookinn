<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JPA entities and DTOs are plain data holders; exposing/storing references
         (mutable collections, Instant, etc.) is intentional, not a defect. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
